            {{ topic | py }}: self.on_{{ topic_attr(topic) }},
{% endfor %}
        }
{% for topic in module.subscribes %}

    def on_{{ topic_attr(topic) }}(self, message: {{ msgtype(topic) }}) -> None:
        self.latest_{{ topic_attr(topic) }} = message
{% endfor %}
{% endif %}

