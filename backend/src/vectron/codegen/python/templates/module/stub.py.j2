        self.latest_{{ topic_attr(topic) }}: {{ msgtype(topic) }} | None = None
{% endfor %}
{% endblock %}
{% block body %}
{% if module.subscribes %}

    def handlers(self) -> Mapping[str, Callable[[Any], None]]:
        return {
