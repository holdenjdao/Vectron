def test_operators_cannot_inject_safety_events() -> None:
    bus, module, modes = make()
    command(bus, {{ breach_path | map("py") | join(", ") }}, "GEOFENCE_BREACH")
    assert module.mode == {{ breach_source | py }}
    assert not modes[-1].accepted


def test_geofence_breach_triggers_{{ breach_target | lower }}() -> None:
    bus, module, _ = make()
    command(bus, {{ breach_path | map("py") | join(", ") }})
    assert module.mode == {{ breach_source | py }}
    bus.publish({{ sub("GeofenceStatus") | py }}, GeofenceStatus(inside=False, breach="RADIUS"))
    assert module.mode == {{ breach_target | py }}
{% endif %}
