{% block body %}

    def handlers(self) -> Mapping[str, Callable[[Any], None]]:
        return {{ "{" }}{{ sub("NmeaSentence") | py }}: self.on_sentence{{ "}" }}

    def on_sentence(self, message: NmeaSentence) -> None:
        text = message.text.strip()
        if not nmea_checksum_ok(text):
            self.rejected += 1
            return
        fields = text[1:].partition("*")[0].split(",")
        if not fields[0].endswith("GGA"):
            return  # other sentence types are not used by this module
        try:
            fix = self.parse_gga(message.t, fields)
        except (IndexError, ValueError):
            self.rejected += 1
            return
        self.publish({{ pub("GnssFix") | py }}, fix)

    def parse_gga(self, t: float, fields: list[str]) -> GnssFix:
        """Build a fix from the comma-separated fields of a GGA sentence."""
        quality = int(fields[6] or 0)
        satellites = int(fields[7] or 0)
        hdop = float(fields[8] or 99.9)
        if quality == 0:
            return GnssFix(t=t, satellites=satellites, hdop=hdop, valid=False)
        valid = satellites >= self.config.min_satellites and hdop <= self.config.max_hdop
        return GnssFix(
            t=t,
            lat_deg=parse_coordinate(fields[2], fields[3]),
            lon_deg=parse_coordinate(fields[4], fields[5]),
            alt_m=float(fields[9] or 0.0),
            satellites=satellites,
            hdop=hdop,
            valid=valid,
        )
{% endblock %}
